[Unit]
Description=Back up finevent SQLite
After=finevent.service

[Service]
Type=oneshot
User=finevent
Group=finevent
ExecStart=/usr/bin/python3 /srv/example/finevent/current/deploy/backup.py
UMask=0077
MemoryMax=48M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/example/finevent-data
