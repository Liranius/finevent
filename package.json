{
  "name": "finevent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @finevent/web dev",
    "server": "go -C apps/server run ./cmd/finevent -data ../../var -web ../web/dist",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "pnpm --filter @finevent/web preview",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:e2e:all": "pnpm build && playwright test",
    "build-only": "pnpm --filter @finevent/web build-only",
    "type-check": "pnpm --filter @finevent/web type-check && tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:style": "stylelint \"**/*.{css,vue}\" --fix",
    "format": "oxfmt",
    "hooks:install": "lefthook install",
    "ci:format": "oxfmt --check",
    "ci:lint": "oxlint . && eslint . && stylelint \"**/*.{css,vue}\"",
    "test:go": "go -C apps/server test ./...",
    "vet:go": "go -C apps/server vet ./...",
    "knowledge:setup": "node scripts/knowledge.mjs setup",
    "knowledge:doctor": "node scripts/knowledge.mjs doctor",
    "knowledge:cli": "node scripts/knowledge.mjs cli",
    "knowledge:check": "node scripts/knowledge-review.mjs check",
    "knowledge:find": "node scripts/knowledge-review.mjs find"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.14",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.4.2"
  },
  "packageManager": "pnpm@12.4.2"
}
